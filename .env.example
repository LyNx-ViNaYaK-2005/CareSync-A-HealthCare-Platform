# ============================================================================
# CareSync - Healthcare Appointment & Follow-up Manager
# Backend environment reference. Copy to `server/.env` and fill in.
#
# Required: MONGODB_URI, JWT_SECRET, ADMIN_EMAIL, ADMIN_PASSWORD
# Optional: GEMINI_API_KEY, SMTP_*, GOOGLE_* - each degrades gracefully when
#           absent (AI falls back to deterministic text, email logs to the
#           console, calendar events are simulated).
# ============================================================================

# ---------------------------------------------------------------- server
PORT=5000
NODE_ENV=development
TIMEZONE=Asia/Kolkata
# Comma-separate to allow multiple origins (e.g. production + Vercel previews)
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------- database
# MongoDB Atlas: cloud.mongodb.com -> free M0 cluster -> Connect -> Drivers.
# Whitelist 0.0.0.0/0 under Network Access so Render can reach the cluster.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/caresync_db?retryWrites=true&w=majority

# Opt-in offline fallbacks. Keep false in any deployed environment: the
# in-memory database discards all data on restart.
ALLOW_LOCAL_DB_FALLBACK=false
ALLOW_INMEMORY_DB=false

# --------------------------------------------------------- authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRY=7d

# ------------------------------------------------------- admin bootstrap
# No API route can create an ADMIN. These seed one at startup; without them
# the admin console cannot be reached on a fresh database.
ADMIN_NAME=Clinic Administrator
ADMIN_EMAIL=admin@caresync.com
ADMIN_PASSWORD=change_this_admin_password

# Demo doctor roster, seeded on first boot.
SEED_SAMPLE_DOCTORS=true
SEED_DOCTOR_PASSWORD=DoctorPassword123!

# ------------------------------------------------------------------- LLM
# Google Gemini free tier: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash
LLM_TIMEOUT_MS=10000

# ----------------------------------------------------------------- email
# Resend, Mailgun, SendGrid, or Gmail app password - anything SMTP.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=re_your_api_key
EMAIL_FROM="CareSync Clinic" <no-reply@caresync.com>

# ------------------------------------------------------- google calendar
# One clinic-owned Google account holds the refresh token; patients and
# doctors are added to events as attendees and need no OAuth of their own.
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REFRESH_TOKEN=your_refresh_token
GOOGLE_REDIRECT_URI=https://developers.google.com/oauthplayground
GOOGLE_CALENDAR_ID=primary

# ------------------------------------------------- background job tuning
SLOT_HOLD_MINUTES=5
REMINDER_TICK_MINUTES=5
REMINDER_WINDOW_MINUTES=15
NOTIFICATION_MAX_ATTEMPTS=3

# ------------------------------------------------------------ rate limits
# Requests per window, per IP.
RATE_LIMIT_AUTH=30
RATE_LIMIT_LLM=10
RATE_LIMIT_BOOKING=20

# ============================================================================
# FRONTEND (client/.env) - Vite only exposes VITE_-prefixed variables
# ============================================================================
# Leave blank for local dev: the Vite proxy forwards /api to localhost:5000.
# In production set it to your deployed backend, e.g.
#   VITE_API_BASE_URL=https://caresync-backend.onrender.com
# VITE_API_BASE_URL=
