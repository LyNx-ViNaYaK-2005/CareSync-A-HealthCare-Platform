# ============================================================================
# CareSync frontend configuration
# Copy to client/.env for local overrides. Only VITE_-prefixed variables are
# exposed to the browser, and Vite inlines them AT BUILD TIME - setting this
# after a deploy has no effect until you rebuild.
# ============================================================================

# Base URL of the backend API.
#
# Local development: leave BLANK. The Vite dev server proxies /api to
# http://localhost:5000 (see vite.config.js), so relative paths just work.
#
# Production (Vercel): set this to your deployed Render backend, with no
# trailing slash, in Project Settings -> Environment Variables:
#   VITE_API_BASE_URL=https://caresync-backend.onrender.com
#
# Whatever value you use here must also appear in the backend's CLIENT_URL
# allow-list, or the browser will block the response with a CORS error.
VITE_API_BASE_URL=
